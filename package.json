{
  "name": "whatsapp-bulk-sender",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "dev:backend": "pnpm --filter backend run dev",
    "dev:worker": "pnpm --filter backend run worker",
    "dev:beat": "pnpm --filter backend run beat",
    "dev:flower": "pnpm --filter backend run flower",
    "setup:backend": "pnpm --filter backend run setup",
    "init:db": "pnpm --filter backend run init:db"
  },
  "devDependencies": {
    "turbo": "^2.9.14"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@1": "1.1.17",
      "brace-expansion@5": "5.0.9",
      "postcss": "8.5.23",
      "nanoid": "3.3.16",
      "js-yaml": "4.3.1",
      "@babel/core": "7.29.6"
    }
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  }
}
